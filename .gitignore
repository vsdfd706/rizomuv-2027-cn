# ===== RizomUV 程序本体与构建产物（绝不入库）=====
# 英文原版备份（使用者自备，含商业软件本体）
rizomuv.exe.bak

# 默认全局排除 exe；下方单独放行“补丁工具”exe（它不含 RizomUV 本体）
*.exe
!dist/RizomUV汉化工具.exe
!dist/RizomUV汉化工具_GBK版.exe

# 构建 / 输出目录
build/
out/
build_pyi/
*.spec

# ===== 虚拟环境 =====
.venv/
venv/

